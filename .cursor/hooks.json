{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {"command": "python3 capture/hk-capture.py hook"}
    ],
    "afterFileEdit": [
      {"command": "python3 capture/hk-capture.py hook"}
    ],
    "beforeShellExecution": [
      {"command": "python3 capture/hk-capture.py hook"}
    ],
    "postToolUse": [
      {"command": "python3 capture/hk-capture.py hook"}
    ],
    "stop": [
      {"command": "python3 capture/hk-capture.py hook"}
    ]
  }
}
